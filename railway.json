{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/index.ts",
      "src/collectors/**",
      "src/config/**",
      "src/filters/**",
      "src/scoring/**",
      "src/report/notion.ts",
      "src/types.ts",
      "test/pipeline.test.ts",
      "test/notion.test.ts",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "Dockerfile",
      ".dockerignore",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "timeout --kill-after=10s 600s npm run daily",
    "cronSchedule": "0 8 * * *",
    "restartPolicyType": "NEVER"
  }
}

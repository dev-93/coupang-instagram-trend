# NAVER API HUB > Application > 인증 정보 (기존 developers.naver.com 키와 다름)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Notion 내부 연동 토큰. 실행 기록 DB에 접근 권한이 있어야 함.
NOTION_TOKEN=

# Telegram 알림 수신용. Codex의 로컬 프로젝트에서만 사용한다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 예약 실패 알림 전용 비서 봇. Mac 로컬 .env에 재발급한 토큰을 설정한다.
# ASSISTANT_TELEGRAM_CHAT_ID를 비우면 TELEGRAM_CHAT_ID를 사용한다.
ASSISTANT_TELEGRAM_BOT_TOKEN=
ASSISTANT_TELEGRAM_CHAT_ID=
